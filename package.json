{
  "name": "siyuan-file-editor",
  "version": "0.1.0",
  "description": "VSCode-like file editor & Obsidian-like file manager for SiYuan, powered by Monaco Editor.",
  "main": "index.js",
  "scripts": {
    "dev": "node tools/clean-env-run.js node_modules/webpack/bin/webpack.js --config webpack.config.js --mode development",
    "build": "node tools/clean-env-run.js node_modules/webpack/bin/webpack.js --config webpack.config.js --mode production",
    "zip": "node scripts/zip-dist.js",
    "package": "npm run build && npm run zip"
  },
  "keywords": [
    "siyuan",
    "monaco",
    "editor",
    "file-manager"
  ],
  "author": "alvisliu",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.4.3",
    "mini-css-extract-plugin": "^2.10.2",
    "monaco-editor": "^0.50.0",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "siyuan": "1.2.2",
    "tslib": "^2.8.1",
    "typescript": "^5.6.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "node-pty": "^1.1.0",
    "quill": "^2.0.3",
    "vditor": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "x-data-spreadsheet": "^1.1.9",
    "xlsx": "^0.18.5"
  }
}
