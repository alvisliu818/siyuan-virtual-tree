node_modules/
dist/
build/
*.zip
.trae/
*.log
.DS_Store
.idea/
.vscode/
# ===== AI 助手工作区 =====
# 私人助手文件由 E:\HOME\Code 私有仓库跟踪，公开仓库一律不提交。
# 注意：只精确放行 memory/，不要写!.workbuddy/ —— 那会把 tmp/ 等
# 过程产物一并放行（.gitignore 对已跟踪文件无效，必须白名单到具体路径）。
.workbuddy/
!.workbuddy/memory/
!.workbuddy/memory/**
# 调试期的临时提交信息文件(git commit -F 用,提交后即删)
tools/_msg.txt
# 临时探测脚本(_cdp.mjs / pty-helper.js / start-siyuan-debug.ps1 除外,它们要入库)
tools/_probe-*
tools/_spawn-*
tools/_reload-*
tools/_shot-*
tools/_verify-*
tools/_pty-helper-test.js
# 实机调试用的临时 CDP 脚本 / 内核协议探测脚本(验证完即弃)
tools/_v1.js
tools/_test-*
tools/__pycache__/
# Dev build outputs at root (legacy, now outputs to SiYuan plugin dir)
/index.js
/index.css
/i18n/
/*.worker.js
/*.ttf
/[0-9]*.js
/vendors-*.js
/node_modules_*.js

# 内部方案文档不入公开仓库
/docs/

# 构建过程日志(根目录 build*.out,历史遗留的 webpack stdout 重定向)
/build*.out
# 一次性诊断/取证脚本与截图(_cdp-*.mjs、_patch_*.py、_shot-*.png 等)
# 约定入库的长期探针(_cdp.mjs / pty-helper.js 等)不在此列
tools/_cdp-*.mjs
tools/_patch_*.py
tools/_shot-*.png
tools/_vc-*.png
# 回收站/CDP 实测脚本与诊断脚本(验证完即弃,文件留磁盘不入库)
tools/_trash-*
tools/_diag*
tools/_reload.mjs

# ===== Yarn 4 PnP(2026-10 迁移,包管理全局 yarn,产物全部可再生不入库) =====
# cache 在 globalFolder(E:/HOME/Code/.yarn-global),不进仓;unplugged 为
# node-pty/zeromq/esbuild 及复制源包(basedpyright 等)的磁盘解压形态,体积大
.pnp.cjs
.pnp.loader.mjs
.yarn/
yarn.lock
# webpack 文件系统缓存(PnP 迁移后从 node_modules/.cache 挪出,node_modules 不应再出现)
.webpack-cache/
# 全局搜索服务接入时的一次性实机诊断脚本/截图(验证完即弃,同 tools/_diag* 约定)
tests/e2e/_*

# 项目内部笔记与 CM6 gutter 调研的一次性产物(文件留磁盘,不入库)
/project_memory.md
tools/_cm-gutter.js
tools/probe-gutter-*.js
tools/probe-overflow-chain.js
tools/probe-widest.js
